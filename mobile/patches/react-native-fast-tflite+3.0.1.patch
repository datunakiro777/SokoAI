+#include <cstdio>
+#include <mutex>
+#if defined(ANDROID)
+#include <android/log.h>
+#endif
+
 namespace margelo::nitro::tflite {
 
+static std::mutex tfliteErrorsMutex;
+static std::string tfliteErrors;
+
+void tfliteErrorReporter(void* /* userData */, const char* format, va_list args) {
+  char message[1024];
+  va_list argsCopy;
+  va_copy(argsCopy, args);
+  vsnprintf(message, sizeof(message), format, argsCopy);
+  va_end(argsCopy);
+#if defined(ANDROID)
+  __android_log_print(ANDROID_LOG_ERROR, "tflite", "%s", message);
+#endif
+  std::lock_guard<std::mutex> lock(tfliteErrorsMutex);
+  if (tfliteErrors.size() < 4096) {
+    if (!tfliteErrors.empty()) tfliteErrors += "\n";
+    tfliteErrors += message;
+  }
+}
+
+std::string takeTfliteErrors() {
+  std::lock_guard<std::mutex> lock(tfliteErrorsMutex);
+  std::string errors = std::move(tfliteErrors);
+  tfliteErrors.clear();
+  return errors.empty() ? "" : "\n" + errors;
+}
+
