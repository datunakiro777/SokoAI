+import java.io.File
+import java.io.RandomAccessFile
+import java.net.URI
 import java.net.URL
+import java.nio.channels.FileChannel
 
 @Keep
 @DoNotStrip
 class HybridAssetLoader : HybridAssetLoaderSpec() {
   override fun loadAsset(path: String): Promise<ArrayBuffer> {
     return Promise.async {
+      if (path.startsWith("file://")) {
+        // "file://model|file://part0|file://part1|..." first joins the parts into the model file.
+        val files = path.split('|').map { File(URI(it)) }
+        val model = files[0]
+        if (files.size > 1) joinParts(model, files.drop(1))
+        // Memory-map large models instead of copying them onto the Java heap.
+        return@async RandomAccessFile(model, "rw").use { file ->
+          ArrayBuffer.wrap(file.channel.map(FileChannel.MapMode.PRIVATE, 0, file.length()))
+        }
+      }
       val bytes = URL(path).readBytes()
       return@async ArrayBuffer.copy(bytes)
     }
   }
+
+  private fun joinParts(model: File, parts: List<File>) {
+    if (model.length() == parts.sumOf { it.length() }) return
+    val temp = File(model.parentFile, "${model.name}.tmp")
+    temp.outputStream().use { output ->
+      for (part in parts) part.inputStream().use { it.copyTo(output, 1 shl 20) }
+    }
+    if (!temp.renameTo(model)) throw Error("Could not write ${model.path}")
+  }
 }
